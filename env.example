# Скопируй эти переменные в Railway → Variables

# Telegram Bot (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdef...

# Твой Telegram ID (узнать у @userinfobot)
ADMIN_ID=123456789

# Канал куда публиковать (@username или -100xxxxxxxxxx)
TARGET_CHANNEL=@my_city_news

# Telegram API (получить на https://my.telegram.org → API development tools)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Строковая сессия Telethon (получить через generate_session.py)
SESSION_STRING=1BVtsOKABu...очень длинная строка...

# OpenRouter API Key (https://openrouter.ai → Keys) — есть бесплатный тариф
OPENROUTER_KEY=sk-or-v1-...
